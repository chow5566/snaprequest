# Supabase Edge Functions Secrets
# 在 Supabase Dashboard → Project Settings → Edge Functions → Secrets 配置，
# 或使用：supabase secrets set --env-file supabase/.env

# 32 字节随机数的 base64（用于 AES-GCM 加密认证信息）
# 生成方式（PowerShell）：
#   $b=[byte[]](0..31|%{Get-Random -Max 256}); [Convert]::ToBase64String($b)
AUTH_ENCRYPTION_KEY=

# 分享页地址，create-snapshot 用它拼接短链接
# 本地先用：http://localhost:5173
SHARE_PAGE_URL=http://localhost:5173
