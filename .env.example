# 扩展端：Supabase 项目配置（publishable/anon key 是公开的，可打包进扩展）
WXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
WXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 分享页面地址
#  - Supabase Storage 公共桶：https://<ref>.supabase.co/storage/v1/object/public/share/snapshot.html
#  - Vercel 等静态站：https://your-domain
WXT_PUBLIC_SHARE_PAGE_URL=https://your-project.supabase.co/storage/v1/object/public/share/snapshot.html
